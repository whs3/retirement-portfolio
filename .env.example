# Copy to .env and adjust. Existing environment variables take precedence.
# Never commit a real .env or .secret_key file.

# Stable Flask/CSRF secret. If unset, the app creates/reuses .secret_key in
# the project root so restarts do not invalidate open sessions.
# SECRET_KEY=replace-with-a-long-random-hex-string

# Optional path for the auto-managed secret file (default: ./.secret_key)
# SECRET_KEY_FILE=.secret_key

# SQLite database and audit log (relative paths resolve from project root)
# PORTFOLIO_DATABASE=portfolio.db
# PORTFOLIO_AUDIT_LOG=portfolio_audit.log

# Backup script defaults (python backup_db.py)
# PORTFOLIO_BACKUP_DIR=backups
# PORTFOLIO_BACKUP_KEEP=14

# Enable Flask debug reloader when using: python app.py
# FLASK_ENV=development
